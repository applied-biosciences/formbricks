# CALM Surveys production environment template — values are examples only.
# Do not put secrets in this file. Inject them into ECS from AWS Secrets Manager.
# This configuration prepares the service for AWS; it does not provision or deploy anything.

WEBAPP_URL=https://surveys.calmos.io
BETTER_AUTH_URL=https://surveys.calmos.io
NEXTAUTH_URL=https://surveys.calmos.io
MAIL_FROM_NAME=CALM Surveys

# RDS PostgreSQL: private subnet, TLS required, encrypted storage and automated backups.
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/formbricks?schema=public&sslmode=require

# ElastiCache for Valkey/Redis: private subnet only.
REDIS_URL=rediss://<elasticache-endpoint>:6379
BULLMQ_EXTERNAL_WORKER_ENABLED=1
BULLMQ_WORKER_ENABLED=0

# S3 object storage. Prefer the ECS task role over static credentials.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=${AWS_REGION}
S3_BUCKET_NAME=<globally-unique-calm-surveys-bucket>
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=false

# ECS/CloudWatch logging and an AWS region that can be set per environment.
AWS_REGION=eu-west-2
LOG_LEVEL=info

# Mandatory application secrets: inject each one from AWS Secrets Manager.
ENCRYPTION_KEY=<secret>
BETTER_AUTH_SECRET=<secret>
CRON_SECRET=<secret>
AUTHZED_TOKEN=<secret>
HUB_API_KEY=<secret>

# Optional telemetry is disabled through the supported setting; no code paths are patched.
DISABLE_TELEMETRY=1
